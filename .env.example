# Meta Model API (Standard tier only, never a -contributor model)
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1

# Muse Spark Open on Baseten (open weights)
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1

# Model per role
PARITY_MODEL_STRUCTURED=muse-spark-1.3
PARITY_MODEL_HARD=muse-wonder-1.0
PARITY_MODEL_COMPUTER=muse-spark-1.3
PARITY_MODEL_SEGMENT=sam-3.1
PARITY_MODEL_TRANSCRIBE=muse-voice-transcribe-1.0
PARITY_MODEL_OPEN=meta-models/muse-spark-open-1026

# Drivers: chromium | lightpanda | cdp
PARITY_BROWSER=chromium
PARITY_CDP_URL=

# Local server and data
PARITY_PORT=8787
PARITY_DB=runs/parity.sqlite
# Optional fixed API token (16+ chars); random per launch when empty
PARITY_TOKEN=
